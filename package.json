{
  "name": "dsh-plugin-quota-badges",
  "version": "1.0.0",
  "description": "DeepSeek Harness bundle: multi-vendor subscription quota badge (OpenCode Zen Go, MiniMax, Kimi Code, DeepSeek) — queries each vendor's usage windows/balance and renders badges next to the composer model selector.",
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "opencode",
    "minimax",
    "kimi",
    "deepseek",
    "quota",
    "usage",
    "rate-limit",
    "subscription",
    "badges"
  ],
  "author": "kola",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kolawong/dsh-plugin-quota-badges.git"
  },
  "bugs": {
    "url": "https://github.com/kolawong/dsh-plugin-quota-badges/issues"
  },
  "homepage": "https://github.com/kolawong/dsh-plugin-quota-badges#readme",
  "license": "MIT",
  "files": [
    "index.js",
    "client.js",
    "usage-core.js",
    "index.d.ts",
    "cordis.patch.yml",
    "providers",
    "README.md",
    "README_CN.md",
    "locale/*.json"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/schemastery": ">=3.0.0"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node -c index.js && node -c client.js"
  }
}
